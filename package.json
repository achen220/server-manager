{
  "name": "server-manager",
  "version": "1.0.0",
  "description": "",
  "main": "dist/desktop/main.js",
  "scripts": {
    "start": "nx run desktop:serve",
    "start:ui": "nx serve frontend",
    "start:api": "nx serve backend",
    "build": "nx run-many -t build -p frontend backend desktop --parallel",
    "build:frontend": "nx build frontend",
    "build:backend": "nx build backend",
    "build:desktop": "nx build desktop",
    "package": "nx run desktop:package",
    "test": "nx run-many -t test --parallel"
  },
  "build": {
    "appId": "com.server-manager.app",
    "productName": "Server Manager",
    "directories": {
      "output": "dist/electron-dist"
    },
    "files": [
      "dist/desktop/**",
      "dist/frontend/**",
      "dist/backend/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achen220/server-manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/achen220/server-manager/issues"
  },
  "homepage": "https://github.com/achen220/server-manager#readme",
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^22.7.5",
    "@nx/devkit": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/nest": "^22.7.5",
    "@nx/node": "^22.7.5",
    "@nx/playwright": "22.7.5",
    "@nx/web": "22.7.5",
    "@nx/webpack": "22.7.5",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~21.2.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.2.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "nx": "^22.7.5",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.10",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular/animations": "^21.2.16",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.1",
    "@primeng/themes": "^21.0.4",
    "@primeuix/themes": "^2.0.3",
    "@supabase/supabase-js": "^2.108.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "ssh2": "^1.17.0",
    "typeorm": "^1.0.0"
  }
}
